// ---------------------------
// In-Memory & Persistent Storage
// ---------------------------
const MEMORY_FILE = "./data/memory.json";
if (!fs.existsSync("./data")) fs.mkdirSync("./data");
if (!fs.existsSync(MEMORY_FILE)) fs.writeFileSync(MEMORY_FILE, "{}");

function getUserMemory(userId) {
  const data = JSON.parse(fs.readFileSync(MEMORY_FILE));
  return data[userId] || [];
}

function addUserMemory(userId, message) {
  const data = JSON.parse(fs.readFileSync(MEMORY_FILE));
  if (!data[userId]) data[userId] = [];
  data[userId].push(message);
  if (data[userId].length > 20) data[userId] = data[userId].slice(-20);
  fs.writeFileSync(MEMORY_FILE, JSON.stringify(data, null, 2));
}

function isAdmin(number) {
  const admins = process.env.ADMINS.split(",");
  return admins.includes(number);
}

